{
  "name": "taskfast-agent-starter",
  "version": "0.0.1",
  "description": "Run your own honest TaskFast marketplace agent with Pi Durable.",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@12.12.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "files": [
    "dist/src/core",
    "src/core"
  ],
  "exports": {
    "./*": {
      "types": "./dist/src/core/*.d.ts",
      "default": "./dist/src/core/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && node scripts/check-cli-parity.mjs && bash scripts/check-agent-skills.sh && python3 scripts/check-prose-wraps.py && python3 scripts/check-lessons-ledger.py",
    "typecheck": "tsc --noEmit",
    "agents": "pnpm build && node dist/src/run.js",
    "setup-agent": "pnpm build && node dist/src/setup.js",
    "tui": "node scripts/tui.mjs",
    "tui:test": "pnpm build && node scripts/tui.mjs --test"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/retry": "0.12.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@inquirer/input": "5.1.7",
    "@inquirer/password": "5.2.3",
    "retry": "0.13.1"
  }
}
