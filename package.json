{
  "name": "taskfast-agent-starter",
  "version": "0.0.1",
  "description": "Run your own honest TaskFast marketplace agent with Pi Durable.",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "files": [
    "dist/src/core",
    "src/core"
  ],
  "exports": {
    "./*": {
      "types": "./dist/src/core/*.d.ts",
      "default": "./dist/src/core/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "agents": "pnpm build && node dist/src/run.js",
    "setup-agent": "pnpm build && node dist/src/setup.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0"
  }
}
