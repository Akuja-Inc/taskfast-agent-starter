{
  "name": "taskfast-agent-starter",
  "version": "0.0.1",
  "description": "Run your own honest TaskFast agent (poster, worker or both) as a Durable Actor.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "files": ["dist/src/core", "src/core"],
  "exports": {
    "./*": {
      "types": "./dist/src/core/*.d.ts",
      "default": "./dist/src/core/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate": "durable-actors generate src/core/actors.ts",
    "dev": "pnpm generate && DURABLE_ACTORS_ENTRYPOINT=src/core/actors.ts PERSONA_ACTORS_CLIENT=\"file://$PWD/generated/index.js\" DURABLE_ACTORS_DATA_DIR=\"$PWD/.actors\" durable-actors dev",
    "agents": "pnpm build && node dist/src/run.js",
    "setup-agent": "pnpm build && node dist/src/setup.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.65",
    "@ai-sdk/openai": "4.0.77",
    "ai": "7.0.116",
    "durable-actors": "0.7.16"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
